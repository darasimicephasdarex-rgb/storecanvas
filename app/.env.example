# Set these only in a local .env or your hosting secrets manager. NEVER commit real values.
SHOPIFY_API_KEY=APP_CLIENT_ID_FROM_DEV_DASHBOARD
SHOPIFY_API_SECRET=APP_CLIENT_SECRET_FROM_DEV_DASHBOARD
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORECANVAS_STORAGE_KEY=GENERATE_UNIQUE_64_HEX_DIGIT_KEY
STORECANVAS_DATA_DIR=./.storecanvas-data
HOST=127.0.0.1
PORT=8787

# Public HTTPS App Home URL must be configured in Shopify Dev Dashboard.
# SHOPIFY_APP_URL=https://your-host.example/app/
