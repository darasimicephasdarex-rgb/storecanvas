{% comment %}
  StoreCanvas: an independently configurable visual design section.
  Install on unpublished themes first. Editable layers use Shopify blocks.
  The Studio exporter may later automate block serialization and publishing.
{% endcomment %}
{{ 'storecanvas-freeform.css' | asset_url | stylesheet_tag }}
<script src="{{ 'storecanvas-freeform.js' | asset_url }}" defer></script>

<section class="sc-freeform" id="sc-freeform-{{ section.id }}"
  style="--sc-bg:{{ section.settings.background }};--sc-radius:{{ section.settings.radius }}px;--sc-height:{{ section.settings.desktop_height }}px;--sc-mobile-height:{{ section.settings.mobile_height }}px;--sc-text:{{ section.settings.text_color }};--sc-max:{{ section.settings.max_width }}px"
  aria-label="{{ section.settings.accessible_name | escape }}">
  <div class="sc-freeform__stage{% if section.settings.allow_overflow %} sc-freeform__stage--overflow{% endif %}">
    {% for block in section.blocks %}
      {% assign entrance = block.settings.entrance | default: 'none' %}
      <div class="sc-freeform__layer sc-entrance-{{ entrance }}"
        data-sc-entrance="{{ entrance }}"
        style="--sc-x:{{ block.settings.x }}%;--sc-y:{{ block.settings.y }}px;--sc-w:{{ block.settings.width }}%;--sc-h:{{ block.settings.height }}px;--sc-mx:{{ block.settings.mobile_x }}%;--sc-my:{{ block.settings.mobile_y }}px;--sc-mw:{{ block.settings.mobile_width }}%;--sc-mh:{{ block.settings.mobile_height }}px;--sc-delay:{{ block.settings.delay }}ms;--sc-duration:{{ block.settings.duration }}ms;--sc-z:{{ block.settings.layer }}"
        {{ block.shopify_attributes }}>
        {% case block.type %}
          {% when 'heading' %}
            <div class="sc-freeform__heading" style="--sc-font:{{ block.settings.font_size }}px;--sc-mobile-font:{{ block.settings.mobile_font_size }}px;--sc-color:{{ block.settings.color }};--sc-weight:{{ block.settings.weight }}">
              <h2>{{ block.settings.heading | escape }}</h2>
            </div>
          {% when 'text' %}
            <div class="sc-freeform__text" style="--sc-font:{{ block.settings.font_size }}px;--sc-mobile-font:{{ block.settings.mobile_font_size }}px;--sc-color:{{ block.settings.color }}">
              {{ block.settings.body }}
            </div>
          {% when 'image' %}
            <div class="sc-freeform__image" style="--sc-image-radius:{{ block.settings.radius }}px;--sc-fit:{{ block.settings.fit }};--sc-blend:{{ block.settings.blend }};--sc-feather:{{ block.settings.feather }}%">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '320, 480, 750, 1100, 1500, 1800', sizes: '(max-width: 749px) 100vw, 50vw', alt: block.settings.image.alt }}
              {% elsif collections.all.products.first.featured_image != blank %}
                {{ collections.all.products.first.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '320, 480, 750, 1100, 1400', alt: 'Featured store product' }}
              {% else %}
                <div class="sc-freeform__image-placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>
          {% when 'button' %}
            {% if block.settings.label != blank %}
              <a class="sc-freeform__button" href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                style="--sc-button-bg:{{ block.settings.background }};--sc-button-color:{{ block.settings.color }};--sc-button-radius:{{ block.settings.radius }}px"
                data-sc-haptic="{{ block.settings.haptic }}">
                {{ block.settings.label | escape }}
              </a>
            {% endif %}
          {% when 'slideshow' %}
            <div class="sc-freeform__slider" role="region" aria-roledescription="carousel" aria-label="{{ block.settings.label | escape }}" data-sc-slider data-sc-autoplay="{{ block.settings.autoplay }}" data-sc-interval="{{ block.settings.interval }}" data-sc-transition="{{ block.settings.transition }}" style="--sc-image-radius:{{ block.settings.radius }}px">
              {% for i in (1..3) %}
                {% liquid
                  assign img_key = 'image_' | append: i
                  assign image = block.settings[img_key]
                %}
                <div class="sc-freeform__slide{% if forloop.first %} is-active{% endif %}" data-sc-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                  {% if image != blank %}
                    {{ image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '320, 750, 1100, 1500', alt: image.alt }}
                  {% else %}
                    <div class="sc-freeform__slide-fallback" aria-hidden="true"></div>
                  {% endif %}
                </div>
              {% endfor %}
              <div class="sc-freeform__slider-actions">
                <button type="button" class="sc-freeform__arrow" data-sc-prev aria-label="Previous slide">‹</button>
                <button type="button" class="sc-freeform__arrow" data-sc-next aria-label="Next slide">›</button>
              </div>
              <button type="button" class="sc-freeform__pause" data-sc-pause aria-pressed="false">Pause slideshow</button>
              <span class="sc-freeform__slider-status visually-hidden" aria-live="polite"></span>
            </div>
        {% endcase %}
      </div>
    {% endfor %}
  </div>
</section>

